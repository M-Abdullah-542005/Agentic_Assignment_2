# ============================================================
# GigBid — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ── Authentication & Security ────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GIGBID_SECRET_KEY=

# ── Marketplace ──────────────────────────────────────────────────────────────
# Token expected by the GigSim / Marketplace MCP server
GIGBID_MARKETPLACE_TOKEN=tok_test

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production / Docker Compose):
DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid

# SQLite (local development fallback — set this OR DATABASE_URL, not both):
# GIGBID_SQLITE_PATH=var/gigbid.db

# ── Redis / Task Queue ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Worker / Scout ───────────────────────────────────────────────────────────
# How often (minutes) the scout worker polls for new jobs
SCOUT_MINUTES=15

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware
CORS_ORIGINS=http://localhost:3000

# ── LLM / Ollama ─────────────────────────────────────────────────────────────
# Base URL for the local Ollama (OpenAI-compatible) endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional: OpenRouter API key (for the "paid" LLM profile)
OPENROUTER_API_KEY=

# Optional: Groq API key (alternative hosted open-weight provider)
GROQ_API_KEY=

# ── Next.js Frontend ─────────────────────────────────────────────────────────
# Exposed to the browser — must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_API=http://localhost:8000

# ── GigBid Environment ───────────────────────────────────────────────────────
# Set to "production" to enforce Postgres + Redis (startup fails without them)
GIGBID_ENV=development

# Optional: override the path to agent/config.yaml
# GIGBID_CONFIG=agent/config.yaml

# ── Workspace MCP server ─────────────────────────────────────────────────────
GIGBID_WORKSPACE_TOKEN=tok_workspace_test

# ── Upwork Live (optional, for upwork marketplace mode) ──────────────────────
UPWORK_MCP_ACCESS_TOKEN=
